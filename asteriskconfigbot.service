[Unit]
Description=Telegram Asterisk Configuration Bot
After=network-online.target asterisk.service
Wants=network-online.target
Requires=asterisk.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/asteriskconfigbot
EnvironmentFile=/opt/asteriskconfigbot/.env
ExecStart=/opt/asteriskconfigbot/venv/bin/python3 /opt/asteriskconfigbot/telegram_asterisk_bot.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
